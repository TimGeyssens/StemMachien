@* Belofte-barometer: visuele score weergave *@

<div class="mb-2">
    <div class="d-flex justify-space-between align-center mb-1">
        <MudText Typo="Typo.body2">@Label</MudText>
        <MudChip T="string" Size="Size.Small" Class="@GetScoreClass()">@Score / 100</MudChip>
    </div>
    <div class="barometer-container">
        <div class="barometer-fill"
             style="width: @Score%; background-position: @(100 - Score)% 0%;">
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Beschrijving))
    {
        <MudText Typo="Typo.caption" Class="mt-1" Style="color: var(--koper); font-style: italic;">
            @Beschrijving
        </MudText>
    }
</div>

@code {
    [Parameter] public int Score { get; set; }
    [Parameter] public string Label { get; set; } = "Overeenkomst";
    [Parameter] public string? Beschrijving { get; set; }

    private string GetScoreClass() => Score switch
    {
        >= 80 => "score-excellent",
        >= 60 => "score-good",
        >= 40 => "score-neutral",
        >= 20 => "score-poor",
        _ => "score-terrible"
    };
}
